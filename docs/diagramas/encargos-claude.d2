...@estilo
direction: right

socialhub: "SocialHub\n(en tu PC)" {class: ink}

drive: "Carpeta «Encargos» de cada marca en Google Drive" {
  class: grupo
  para: "para-claude\nespecificaciones, textos, revisiones,\nbalances, investigación, propuestas" {class: base}
  parapc: "para-claude-pc\nprogramar en Publer, comprobar,\nleer calendario y métricas" {class: base}
  de: "de-claude\nresultados" {class: ok}
}

nube: "Tarea programada «Encargos de SocialHub»\nen la nube · cada 5 h: 0:30, 5:30, 10:30, 15:30 y 20:30" {class: run}
pc: "Tarea programada «Publicar con Chrome»\nen tu PC · cada 5 h: 0:50, 5:50, 10:50, 15:50 y 20:50" {class: run}

socialhub -> drive.para: "deja el encargo" {class: flecha}
socialhub -> drive.parapc: "deja el encargo" {class: flecha}
drive.para -> nube {class: flecha}
drive.parapc -> pc {class: flecha}
nube -> drive.de: "resultado" {class: flecha}
pc -> drive.de: "resultado" {class: flecha}
drive.de -> socialhub: "lo comprueba y lo aplica" {class: flecha}
