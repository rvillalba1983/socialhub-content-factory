# Colores de la web de SocialHub (frontend/src/styles.css, tema claro)
vars: {
  d2-config: {
    pad: 40
  }
}
style: {
  fill: "#F4F5F7"
}
classes: {
  base: {
    style: {fill: "#FFFFFF"; stroke: "#D2D7DE"; font-color: "#0D1117"; border-radius: 12; stroke-width: 2; font-size: 16}
  }
  ok: {style: {fill: "#E5F5EC"; stroke: "#0F9A50"; font-color: "#0D1117"; border-radius: 12; stroke-width: 2; font-size: 16}}
  run: {style: {fill: "#E8EEFD"; stroke: "#2F67E8"; font-color: "#0D1117"; border-radius: 12; stroke-width: 2; font-size: 16}}
  wait: {style: {fill: "#FBF2D9"; stroke: "#B57D06"; font-color: "#0D1117"; border-radius: 12; stroke-width: 2; font-size: 16}}
  block: {style: {fill: "#FDEDE1"; stroke: "#DD5F0B"; font-color: "#0D1117"; border-radius: 12; stroke-width: 2; font-size: 16}}
  err: {style: {fill: "#FDE8E8"; stroke: "#DF3B3B"; font-color: "#0D1117"; border-radius: 12; stroke-width: 2; font-size: 16}}
  idle: {style: {fill: "#EDEFF2"; stroke: "#8A93A1"; font-color: "#4A5361"; border-radius: 12; stroke-width: 2; font-size: 16}}
  cancel: {style: {fill: "#ECEDEF"; stroke: "#6A7280"; font-color: "#4A5361"; border-radius: 12; stroke-width: 2; stroke-dash: 4; font-size: 16}}
  ink: {style: {fill: "#0D1117"; stroke: "#0D1117"; font-color: "#FFFFFF"; border-radius: 12; font-size: 16; bold: true}}
  grupo: {style: {fill: "#FFFFFF"; stroke: "#E2E5EA"; font-color: "#4A5361"; border-radius: 16; stroke-width: 2; font-size: 18; bold: true}}
  flecha: {style: {stroke: "#4A5361"; font-color: "#4A5361"; stroke-width: 2; font-size: 14}}
  manual: {style: {stroke: "#B57D06"; font-color: "#B57D06"; stroke-width: 2; stroke-dash: 5; font-size: 14}}
}
