...@estilo
direction: down

programada: "Pasas la publicación a «Programada»\n(aprobada, sin avisos y con 6 h de margen)" {class: ink}

publer: "1 · Publer\nClaude la programa con Chrome en tu PC\nhasta 8 h antes (espera hasta 7 h antes)" {class: run}
publora: "2 · Publora\nSocialHub la sube y la programa por su API\nhasta 6 h antes" {class: run}
oficial: "3 · API oficial\naparcada: figura como «no configurada»" {class: cancel}
reintento: "¿Queda margen?\nreintento cada hora por todas las vías" {class: wait; shape: diamond}
manual: "A mano\nLEEME en la carpeta de aprobados + aviso" {class: block}

hora: "A la hora: «Publicando»" {class: run}
comprobar: "Comprobación\nPublora por API cada 5 min · Publer o a mano: Claude con Chrome" {class: wait}
publicada: "Publicada\ncon enlace o identificador" {class: ok}
error: "Error de publicación + aviso" {class: err}

programada -> publer {class: flecha}
publer -> publora: "falla o no llega a tiempo" {class: flecha}
publora -> oficial: "falla" {class: flecha}
oficial -> reintento {class: flecha}
reintento -> publer: "sí" {class: manual}
reintento -> manual: "no" {class: flecha}
publer -> hora: "programada" {class: flecha}
publora -> hora: "programada" {class: flecha}
manual -> hora: "la publicas tú" {class: manual}
hora -> comprobar {class: flecha}
comprobar -> publicada: "la ve" {class: flecha}
comprobar -> error: "no aparece" {class: flecha}
