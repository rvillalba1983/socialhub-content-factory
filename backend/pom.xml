<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.socialhub</groupId>
  <artifactId>socialhub</artifactId>
  <!-- La versión sale de aquí. Las compilaciones de GitHub la sustituyen con -Drevision=... (Maven 3.5+, sin plugins extra) -->
  <version>${revision}</version>
  <name>SocialHub</name>
  <description>Fábrica de contenido para redes sociales</description>

  <properties>
    <revision>1.2.0</revision>
    <!-- Commit con el que se compila; el workflow de instaladores lo pasa con -Dsocialhub.commit=... -->
    <socialhub.commit>local</socialhub.commit>
    <java.version>25</java.version>
    <spring-modulith.version>2.1.2</spring-modulith.version>
    <jmolecules.version>2025.0.2</jmolecules.version>
    <archunit.version>1.5.1</archunit.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <openapi-generator.version>7.26.0</openapi-generator.version>
    <!-- Binarios de PostgreSQL usados en desarrollo y pruebas (el instalador trae los suyos) -->
    <postgres.binaries.version>18.6.0</postgres.binaries.version>
    <postgres.binaries.artifact>embedded-postgres-binaries-linux-amd64</postgres.binaries.artifact>
    <!-- FFmpeg incluido (bytedeco, variante GPL con H.264): el ejecutable del sistema en el que se compila -->
    <javacpp.version>1.5.14</javacpp.version>
    <ffmpeg.version>8.1.2-${javacpp.version}</ffmpeg.version>
    <javacpp.platform>linux-x86_64</javacpp.platform>
    <!-- Pruebas de mutación (PIT): `mvn test-compile org.pitest:pitest-maven:mutationCoverage`. No va en `verify`.
         Umbral de mutantes matados: 0 por defecto; la PR lo sube con -Dpit.threshold=75 (ver .github/workflows/mutacion.yml) -->
    <pitest.version>1.30.2</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <pit.threshold>0</pit.threshold>
    <pit.targetClasses>com.socialhub.*</pit.targetClasses>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jmolecules</groupId>
        <artifactId>jmolecules-bom</artifactId>
        <version>${jmolecules.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- ArchUnit no tiene BOM: todas sus piezas en la misma versión (si no, Modulith arrastra la 1.4.1 hasta el jar) -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5-api</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5-engine</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5-engine-api</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web y validación -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistencia: JPA, auditoría con Envers, migraciones con Flyway -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-envers</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <!-- En compilación: las copias usan su API de COPY (Fase 9) -->
    </dependency>

    <!-- Observabilidad: Micrometer (Observation API) con ID de traza en los registros -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>

    <!-- Arquitectura: módulos (Spring Modulith) y DDD/hexagonal (jMolecules).
         En ejecución solo hacen falta las anotaciones (@ApplicationModule...); el análisis (Modulith core, ArchUnit)
         queda para las pruebas. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jmolecules</groupId>
      <artifactId>jmolecules-ddd</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jmolecules</groupId>
      <artifactId>jmolecules-hexagonal-architecture</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jmolecules</groupId>
      <artifactId>jmolecules-events</artifactId>
    </dependency>

    <!-- Menos código repetitivo: Lombok y MapStruct -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
      <classifier>${javacpp.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>${ffmpeg.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>${ffmpeg.version}</version>
      <classifier>${javacpp.platform}-gpl</classifier>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>
    <!-- Valida los resultados de Claude contra contracts/task-result.v1.schema.json (Jackson 3) -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>3.0.8</version>
    </dependency>

    <!-- PostgreSQL incluido -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.28.0</version>
    </dependency>
    <dependency>
      <groupId>org.tukaani</groupId>
      <artifactId>xz</artifactId>
      <version>1.12</version>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>${postgres.binaries.artifact}</artifactId>
      <version>${postgres.binaries.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Pruebas -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jmolecules.integrations</groupId>
      <artifactId>jmolecules-archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>socialhub</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- META-INF/build-info.properties: versión y fecha de compilación, que la web enseña -->
          <execution>
            <id>build-info</id>
            <goals><goal>build-info</goal></goals>
            <configuration>
              <additionalProperties>
                <commit>${socialhub.commit}</commit>
              </additionalProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- API first: interfaces de controladores y modelos generados desde contracts/openapi.yaml -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../contracts/openapi.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.socialhub.api</apiPackage>
              <modelPackage>com.socialhub.api.model</modelPackage>
              <modelNameSuffix>Dto</modelNameSuffix>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <apisToGenerate>Factory,AppMode,Brands,Promotions,Pieces,Publications,Claude,Tasks,Stations,Armory,ExternalOperations,Publora,Publer,Instagram,Backups,App</apisToGenerate>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <skipDefaultInterface>true</skipDefaultInterface>
                <openApiNullable>false</openApiNullable>
                <useBeanValidation>true</useBeanValidation>
                <performBeanValidation>false</performBeanValidation>
                <documentationProvider>none</documentationProvider>
                <annotationLibrary>none</annotationLibrary>
                <dateLibrary>java8</dateLibrary>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>0.2.0</version>
            </path>
            <!-- Lista los módulos y sus eventos en META-INF/spring-modulith (para la documentación) -->
            <path>
              <groupId>org.springframework.modulith</groupId>
              <artifactId>spring-modulith-apt</artifactId>
              <version>${spring-modulith.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amapstruct.defaultComponentModel=spring</arg>
            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!-- La web compilada (frontend/dist) se sirve desde la propia aplicación en localhost:8686 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copiar-frontend</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
              <resources>
                <resource><directory>${project.basedir}/../frontend/dist</directory></resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copiar-contratos</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/contracts</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../contracts</directory>
                  <includes><include>*.schema.json</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Pruebas de mutación: mide si las pruebas detectan cambios en el código (calidad, no cobertura) -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>${pit.targetClasses}</param>
          </targetClasses>
          <targetTests>
            <param>com.socialhub.*</param>
          </targetTests>
          <excludedClasses>
            <!-- API generada desde el contrato, mapeadores generados y arranque -->
            <param>com.socialhub.api.*</param>
            <param>*MapperImpl</param>
            <param>com.socialhub.SocialHubApplication</param>
          </excludedClasses>
          <mutationThreshold>${pit.threshold}</mutationThreshold>
          <threads>2</threads>
          <jvmArgs>
            <value>-Xmx3g</value>
            <value>-XX:+ExitOnOutOfMemoryError</value>
          </jvmArgs>
          <timeoutConstant>8000</timeoutConstant>
          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
          <failWhenNoMutations>false</failWhenNoMutations>
          <avoidCallsTo>
            <param>org.slf4j</param>
            <param>java.util.logging</param>
          </avoidCallsTo>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Binarios de PostgreSQL según el sistema en el que se compila -->
  <profiles>
    <!-- Mutación solo con las pruebas unitarias (-Ppit-unitarias): sin las que arrancan Spring y PostgreSQL.
         Cada mutante que sobrevive a las unitarias volvería a arrancar contexto y base de datos (minutos por mutante) -->
    <profile>
      <id>pit-unitarias</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <excludedTestClasses>
              <param>*.StartUpTest</param>
              <param>*.AiAutoRetryTest</param>
              <param>*.AiTypesTest</param>
              <param>*.AiExchangeTest</param>
              <param>*.ApiIntegrationTest</param>
              <param>*.EmbeddedPostgresTest</param>
              <param>*.BrandFolderRootTest</param>
              <param>*.SpecBatchesTest</param>
              <param>*FlowTest</param>
              <param>*.FlowClockConfig</param>
              <param>*.ModesAndRegistrationTest</param>
              <param>*.PublishingEngineTest</param>
              <param>*.PublishingModuleTest</param>
              <param>*.PromotionMetricsApiTest</param>
              <param>*.AutoRequestsTest</param>
              <param>*.PublerAccountTest</param>
              <param>*.InstagramOAuthTest</param>
              <param>*.InstagramRouteTest</param>
              <param>*.RouteOrderMigrationTest</param>
              <param>*.PubloraRouteTest</param>
              <param>*.ProductionModuleTest</param>
              <param>*.BackupIntegrationTest</param>
              <param>*.TaskEngineTest</param>
              <param>*.PiecesApiTest</param>
              <param>*.ModularityTest</param>
              </excludedTestClasses>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>pg-windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties>
        <postgres.binaries.artifact>embedded-postgres-binaries-windows-amd64</postgres.binaries.artifact>
        <javacpp.platform>windows-x86_64</javacpp.platform>
      </properties>
    </profile>
    <profile>
      <id>pg-mac-arm</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties>
        <postgres.binaries.artifact>embedded-postgres-binaries-darwin-arm64v8</postgres.binaries.artifact>
        <javacpp.platform>macosx-arm64</javacpp.platform>
      </properties>
    </profile>
    <profile>
      <id>pg-mac-intel</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties>
        <postgres.binaries.artifact>embedded-postgres-binaries-darwin-amd64</postgres.binaries.artifact>
        <javacpp.platform>macosx-x86_64</javacpp.platform>
      </properties>
    </profile>
    <profile>
      <id>pg-linux-arm</id>
      <activation><os><name>linux</name><arch>aarch64</arch></os></activation>
      <properties>
        <postgres.binaries.artifact>embedded-postgres-binaries-linux-arm64v8</postgres.binaries.artifact>
        <javacpp.platform>linux-arm64</javacpp.platform>
      </properties>
    </profile>
  </profiles>
</project>
